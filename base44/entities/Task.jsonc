{
  "name": "Task",
  "type": "object",
  "properties": {
    "task_type": {
      "type": "string",
      "enum": [
        "project",
        "general"
      ],
      "default": "project",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05d9\u05de\u05d4 - \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d0\u05d5 \u05db\u05dc\u05dc\u05d9\u05ea"
    },
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "phase_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05dc\u05d1"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3 \u05de\u05de\u05d5\u05e7\u05d3"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e1\u05d9\u05d5\u05dd"
    }
  },
  "required": [
    "name"
  ]
}