{
  "name": "KnowledgeChunk",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05d5\u05db\u05df \u05e9\u05d4\u05d9\u05d3\u05e2 \u05e9\u05d9\u05d9\u05da \u05d0\u05dc\u05d9\u05d5"
    },
    "file_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "file_url": {
      "type": "string",
      "description": "URL \u05e9\u05dc \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05d7\u05d5\u05dc\u05e5 \u05de\u05d4\u05e7\u05d5\u05d1\u05e5"
    },
    "chunk_index": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d9\u05e0\u05d3\u05e7\u05e1 \u05d4\u05d7\u05dc\u05e7 (\u05d0\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05e4\u05d5\u05e6\u05dc)"
    }
  },
  "required": [
    "agent_id",
    "file_name",
    "content"
  ]
}