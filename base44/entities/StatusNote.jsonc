{
  "name": "StatusNote",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "category": {
      "type": "string",
      "enum": [
        "status_update",
        "action_item",
        "discussion_topic",
        "summary"
      ],
      "default": "action_item",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4: \u05e2\u05d3\u05db\u05d5\u05df \u05e1\u05d8\u05d8\u05d5\u05e1, \u05e4\u05e8\u05d9\u05d8 \u05e2\u05d1\u05d5\u05d3\u05d4, \u05e0\u05d5\u05e9\u05d0 \u05dc\u05d3\u05d9\u05d5\u05df, \u05e1\u05d9\u05db\u05d5\u05dd"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done"
      ],
      "default": "open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d8\u05d8\u05d5\u05e1 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05e7\u05e9\u05d5\u05e8"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    }
  },
  "required": [
    "project_id",
    "content",
    "category"
  ]
}